{
  "_type": "export",
  "__export_format": 4,
  "resources": [
    {"_id": "wrk_musicbot", "_type": "workspace", "name": "MusicBot"},
    {"_id": "env_base", "_type": "environment", "parentId": "wrk_musicbot", "name": "Base",
      "data": {"base_url": "http://127.0.0.1:5000", "session": "COLE_SEU_COOKIE_AQUI", "chat_id": 80, "documento_id": 1, "playlist_id": "COLE_ID_PLAYLIST"}},
    {"_id": "fld_agent", "_type": "request_group", "parentId": "wrk_musicbot", "name": "Agent — Testes"},
    {"_id": "req_agent_buscar_musica", "_type": "request", "parentId": "fld_agent", "name": "Buscar Música",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Toca Creep do Radiohead\"}"}},
    {"_id": "req_agent_recentes", "_type": "request", "parentId": "fld_agent", "name": "Músicas Recentes",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"O que eu ouvi recentemente?\"}"}},
    {"_id": "req_agent_top_tracks", "_type": "request", "parentId": "fld_agent", "name": "Top Músicas",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Quais são minhas músicas mais ouvidas das ultimas 4 semanas?\"}"}},
    {"_id": "req_agent_top_artists", "_type": "request", "parentId": "fld_agent", "name": "Top Artistas",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Quais são meus artistas favoritos das ultimas 4 semanas?\"}"}},
    {"_id": "req_agent_curtidas", "_type": "request", "parentId": "fld_agent", "name": "Músicas Curtidas",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Quais músicas eu curtei no Spotify?\"}"}},
    {"_id": "req_agent_playlists", "_type": "request", "parentId": "fld_agent", "name": "Listar Playlists",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Quais são minhas playlists?\"}"}},
    {"_id": "req_agent_criar_playlist", "_type": "request", "parentId": "fld_agent", "name": "Criar Playlist",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Cria uma playlist chamada MusicBot Favorites\"}"}},
    {"_id": "req_agent_add_playlist", "_type": "request", "parentId": "fld_agent", "name": "Adicionar Música à Playlist",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Adiciona Creep do Radiohead na minha playlist MusicBot Favorites\"}"}},
    {"_id": "req_agent_artista", "_type": "request", "parentId": "fld_agent", "name": "Buscar Artista",
      "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Me fala sobre o Radiohead\"}"}},
    {"_id": "fld_auth", "_type": "request_group", "parentId": "wrk_musicbot", "name": "Auth"},
    {"_id": "req_login", "_type": "request", "parentId": "fld_auth", "name": "Login Spotify", "method": "GET", "url": "{{ _.base_url }}/auth/login"},
    {"_id": "req_logout", "_type": "request", "parentId": "fld_auth", "name": "Logout", "method": "GET", "url": "{{ _.base_url }}/auth/logout", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_debug", "_type": "request", "parentId": "fld_auth", "name": "Debug Session", "method": "GET", "url": "{{ _.base_url }}/auth/debug", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "fld_spotify", "_type": "request_group", "parentId": "wrk_musicbot", "name": "Spotify"},
    {"_id": "req_profile", "_type": "request", "parentId": "fld_spotify", "name": "Perfil", "method": "GET", "url": "{{ _.base_url }}/profile", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_playlists", "_type": "request", "parentId": "fld_spotify", "name": "Playlists", "method": "GET", "url": "{{ _.base_url }}/playlists", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_top_tracks", "_type": "request", "parentId": "fld_spotify", "name": "Top Tracks", "method": "GET", "url": "{{ _.base_url }}/top-tracks", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_top_artists", "_type": "request", "parentId": "fld_spotify", "name": "Top Artists", "method": "GET", "url": "{{ _.base_url }}/top-artists", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_recently_played", "_type": "request", "parentId": "fld_spotify", "name": "Recently Played", "method": "GET", "url": "{{ _.base_url }}/recently-played", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_search_track", "_type": "request", "parentId": "fld_spotify", "name": "Search Track", "method": "GET", "url": "{{ _.base_url }}/search-track?q=Creep+Radiohead", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "fld_chat", "_type": "request_group", "parentId": "wrk_musicbot", "name": "Chat"},
    {"_id": "req_criar_chat", "_type": "request", "parentId": "fld_chat", "name": "Criar Chat", "method": "POST", "url": "{{ _.base_url }}/chat/",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"titulo\": \"Teste Agent\"}"}},
    {"_id": "req_listar_chats", "_type": "request", "parentId": "fld_chat", "name": "Listar Chats", "method": "GET", "url": "{{ _.base_url }}/chat/", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_enviar_msg", "_type": "request", "parentId": "fld_chat", "name": "Enviar Mensagem", "method": "POST", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/message",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"mensagem\": \"Toca Creep do Radiohead\"}"}},
    {"_id": "req_historico", "_type": "request", "parentId": "fld_chat", "name": "Histórico de Mensagens", "method": "GET", "url": "{{ _.base_url }}/chat/{{ _.chat_id }}/messages", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "fld_rag", "_type": "request_group", "parentId": "wrk_musicbot", "name": "RAG"},
    {"_id": "req_submeter_doc", "_type": "request", "parentId": "fld_rag", "name": "Submeter Documento", "method": "POST", "url": "{{ _.base_url }}/rag/documentos",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\n  \"titulo\": \"Teste\",\n  \"tipo\": \"txt\",\n  \"conteudo\": \"Conteúdo do documento aqui.\",\n  \"super_usuario_id\": 1\n}"}},
    {"_id": "req_listar_docs", "_type": "request", "parentId": "fld_rag", "name": "Listar Documentos Pendentes", "method": "GET", "url": "{{ _.base_url }}/rag/documentos?status=pendente", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_aprovar_doc", "_type": "request", "parentId": "fld_rag", "name": "Aprovar Documento", "method": "POST", "url": "{{ _.base_url }}/rag/documentos/{{ _.documento_id }}/aprovar", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]},
    {"_id": "req_rejeitar_doc", "_type": "request", "parentId": "fld_rag", "name": "Rejeitar Documento", "method": "POST", "url": "{{ _.base_url }}/rag/documentos/{{ _.documento_id }}/rejeitar",
      "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}, {"name": "Content-Type", "value": "application/json"}],
      "body": {"mimeType": "application/json", "text": "{\"motivo\": \"Conteúdo duplicado\"}"}},
    {"_id": "req_buscar_rag", "_type": "request", "parentId": "fld_rag", "name": "Buscar RAG", "method": "GET", "url": "{{ _.base_url }}/rag/buscar?q=beatles", "headers": [{"name": "Cookie", "value": "session={{ _.session }}"}]}
  ]
}
